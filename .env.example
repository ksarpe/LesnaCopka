# Skopiuj do .env.local i uzupełnij.
# mock = dane w aplikacji (domyślnie), supabase = backend Supabase (lokalny albo w chmurze)
EXPO_PUBLIC_BACKEND=mock
# Lokalnie: http://<IP komputera w sieci>:54321 (npx supabase status), w chmurze: https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Narzędzia deweloperskie (panel /dev, symulacja GPS i aparatu) w buildzie: 1 = włączone.
# W `npx expo start` (dev) są zawsze; w eas.json ustawiają je profile development i preview, production – nie.
EXPO_PUBLIC_DEV_TOOLS=
