# Sekrety Edge Function `identify` (rozpoznawanie grzyba ze zdjęcia przez Claude – Anthropic API).
# Lokalnie: skopiuj do supabase/functions/.env (git go ignoruje), uzupełnij i uruchom
#   npx supabase functions serve identify --env-file supabase/functions/.env
# W chmurze: npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-… (opcjonalnie IDENTIFY_MODEL=…).
# Nigdy nie commituj prawdziwego klucza i nie wpisuj go do .env.local aplikacji (EXPO_PUBLIC_* trafia do aplikacji).

# Klucz API z https://console.anthropic.com (wymagany w wydaniu).
ANTHROPIC_API_KEY=
# Model (domyślnie claude-opus-5-5). Tańsza opcja: claude-haiku-5-5.
IDENTIFY_MODEL=

# ── Tylko testy dewelopera: Google Gemini (np. darmowy klucz z https://aistudio.google.com/apikey) ──
# NIE do wydania: warunki Gemini API dla użytkowników z EOG dopuszczają tylko płatny dostęp, a w darmowym Google
# używa zdjęć do ulepszania usług. Bez ANTHROPIC_API_KEY sam GEMINI_API_KEY też włącza Gemini.
# IDENTIFY_PROVIDER=gemini
GEMINI_API_KEY=
# Model (domyślnie gemini-3.8-flash). Tańszy: gemini-3.5-flash-lite.
GEMINI_MODEL=
